{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onUnload",
		"onTimer"
	],
	"method": "method.4dm",
	"windowTitle": "SVG Draw Tool",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"toolSelect": {
					"type": "checkbox",
					"text": "Select",
					"style": "toolbar",
					"top": 20,
					"left": 20,
					"width": 80,
					"height": 24,
					"dataSource": "Form.toolSelect",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/toolSelect.4dm"
				},
				"toolLine": {
					"type": "checkbox",
					"text": "Line",
					"style": "toolbar",
					"top": 20,
					"left": 104,
					"width": 80,
					"height": 24,
					"dataSource": "Form.toolLine",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/toolLine.4dm"
				},
				"canvas": {
					"type": "input",
					"left": 20,
					"top": 52,
					"width": 500,
					"height": 400,
					"dataSource": "Form.SVG",
					"dataSourceTypeHint": "picture",
					"enterable": false,
					"focusable": true,
					"contextMenu": "none",
					"dragging": "none",
					"dropping": "none",
					"pictureFormat": "truncatedTopLeft",
					"events": [
						"onLoad",
						"onClick"
					],
					"method": "ObjectMethods/canvas.4dm"
				}
			}
		}
	]
}