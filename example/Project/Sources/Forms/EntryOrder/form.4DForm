{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onUnload",
		"onPageChange"
	],
	"method": "method.4dm",
	"windowTitle": "Entry Order Tests",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"tabNav": {
					"type": "tab",
					"left": 20,
					"top": 10,
					"width": 500,
					"height": 24,
					"labels": ["1: Default", "2: Custom", "3: Subset", "4: Runtime", "5: Skip"],
					"action": "gotoPage"
				},
				"status": {
					"type": "input",
					"left": 20,
					"top": 380,
					"width": 500,
					"height": 17,
					"dataSource": "Form.status",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"focusable": false
				}
			}
		},
		{
			"objects": {
				"label1": {
					"type": "text",
					"text": "Default entry order = JSON declaration order (try Tab)",
					"top": 50,
					"left": 20,
					"width": 460,
					"height": 20
				},
				"A": {
					"type": "input",
					"left": 20,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "1st (A)",
					"dataSource": "Form.a",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"B": {
					"type": "input",
					"left": 180,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "2nd (B)",
					"dataSource": "Form.b",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"C": {
					"type": "input",
					"left": 340,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "3rd (C)",
					"dataSource": "Form.c",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"D": {
					"type": "input",
					"left": 20,
					"top": 120,
					"width": 140,
					"height": 22,
					"placeholder": "4th (D)",
					"dataSource": "Form.d",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"E": {
					"type": "input",
					"left": 180,
					"top": 120,
					"width": 140,
					"height": 22,
					"placeholder": "5th (E)",
					"dataSource": "Form.e",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				}
			}
		},
		{
			"objects": {
				"label2": {
					"type": "text",
					"text": "Custom entry order: Z → X → Y (reverse of JSON order)",
					"top": 50,
					"left": 20,
					"width": 460,
					"height": 20
				},
				"X": {
					"type": "input",
					"left": 20,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "JSON 1st → Tab 2nd (X)",
					"dataSource": "Form.x",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"Y": {
					"type": "input",
					"left": 180,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "JSON 2nd → Tab 3rd (Y)",
					"dataSource": "Form.y",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"Z": {
					"type": "input",
					"left": 340,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "JSON 3rd → Tab 1st (Z)",
					"dataSource": "Form.z",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				}
			},
			"entryOrder": [
				"Z",
				"X",
				"Y"
			]
		},
		{
			"objects": {
				"label3": {
					"type": "text",
					"text": "Subset: only First and Third are tabbable (Middle is skipped)",
					"top": 50,
					"left": 20,
					"width": 460,
					"height": 20
				},
				"First": {
					"type": "input",
					"left": 20,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "Tabbable (First)",
					"dataSource": "Form.first",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"Middle": {
					"type": "input",
					"left": 180,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "Skipped (Middle)",
					"dataSource": "Form.middle",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"Third": {
					"type": "input",
					"left": 340,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "Tabbable (Third)",
					"dataSource": "Form.third",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				}
			},
			"entryOrder": [
				"First",
				"Third"
			]
		},
		{
			"objects": {
				"label4": {
					"type": "text",
					"text": "Runtime: click Reverse to flip order, Reset to restore",
					"top": 50,
					"left": 20,
					"width": 460,
					"height": 20
				},
				"R1": {
					"type": "input",
					"left": 20,
					"top": 80,
					"width": 100,
					"height": 22,
					"placeholder": "R1",
					"dataSource": "Form.r1",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"R2": {
					"type": "input",
					"left": 140,
					"top": 80,
					"width": 100,
					"height": 22,
					"placeholder": "R2",
					"dataSource": "Form.r2",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"R3": {
					"type": "input",
					"left": 260,
					"top": 80,
					"width": 100,
					"height": 22,
					"placeholder": "R3",
					"dataSource": "Form.r3",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"R4": {
					"type": "input",
					"left": 380,
					"top": 80,
					"width": 100,
					"height": 22,
					"placeholder": "R4",
					"dataSource": "Form.r4",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"btnReverse": {
					"type": "button",
					"text": "Reverse",
					"left": 20,
					"top": 120,
					"width": 100,
					"height": 24,
					"events": ["onClick"],
					"method": "ObjectMethods/btnReverse.4dm"
				},
				"btnReset": {
					"type": "button",
					"text": "Reset",
					"left": 140,
					"top": 120,
					"width": 100,
					"height": 24,
					"events": ["onClick"],
					"method": "ObjectMethods/btnReset.4dm"
				}
			}
		},
		{
			"objects": {
				"label5": {
					"type": "text",
					"text": "GOTO OBJECT: click buttons to jump focus to a specific field",
					"top": 50,
					"left": 20,
					"width": 460,
					"height": 20
				},
				"Name": {
					"type": "input",
					"left": 20,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "Name",
					"dataSource": "Form.name",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"Email": {
					"type": "input",
					"left": 180,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "Email",
					"dataSource": "Form.email",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"Phone": {
					"type": "input",
					"left": 340,
					"top": 80,
					"width": 140,
					"height": 22,
					"placeholder": "Phone",
					"dataSource": "Form.phone",
					"dataSourceTypeHint": "text",
					"events": ["onGettingFocus"]
				},
				"btnGotoName": {
					"type": "button",
					"text": "→ Name",
					"left": 20,
					"top": 120,
					"width": 100,
					"height": 24,
					"events": ["onClick"],
					"method": "ObjectMethods/btnGotoName.4dm"
				},
				"btnGotoEmail": {
					"type": "button",
					"text": "→ Email",
					"left": 140,
					"top": 120,
					"width": 100,
					"height": 24,
					"events": ["onClick"],
					"method": "ObjectMethods/btnGotoEmail.4dm"
				},
				"btnGotoPhone": {
					"type": "button",
					"text": "→ Phone",
					"left": 260,
					"top": 120,
					"width": 100,
					"height": 24,
					"events": ["onClick"],
					"method": "ObjectMethods/btnGotoPhone.4dm"
				},
				"btnClearFocus": {
					"type": "button",
					"text": "Clear Focus",
					"left": 380,
					"top": 120,
					"width": 100,
					"height": 24,
					"events": ["onClick"],
					"method": "ObjectMethods/btnClearFocus.4dm"
				}
			}
		}
	]
}
