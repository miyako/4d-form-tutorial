{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "windowSizingX": "variable",
  "windowSizingY": "variable",
  "windowMinWidth": 0,
  "windowMinHeight": 0,
  "windowMaxWidth": 32767,
  "windowMaxHeight": 32767,
  "rightMargin": 20,
  "bottomMargin": 20,
  "events": ["onLoad", "onClick", "onDoubleClick", "onUnload"],
  "windowTitle": "Event Showcase",
  "destination": "detailScreen",
  "formClass": "EventShowcaseController",
  "pages": [
    {
      "objects": {
        "Title": {
          "type": "text",
          "text": "Event Showcase",
          "top": 10,
          "left": 20,
          "width": 300,
          "height": 30,
          "fontSize": 18,
          "fontWeight": "bold"
        },
        "LabelLog": {
          "type": "text",
          "text": "Event Log:",
          "top": 10,
          "left": 250,
          "width": 100,
          "height": 20,
          "fontWeight": "bold"
        },
        "LogDisplay": {
          "type": "input",
          "top": 30,
          "left": 250,
          "width": 280,
          "height": 260,
          "enterable": false,
          "multiline": "yes",
          "dataSource": "Form.log",
          "borderStyle": "solid"
        },
        "LabelCount": {
          "type": "text",
          "text": "Total Clicks:",
          "top": 300,
          "left": 250,
          "width": 100,
          "height": 20
        },
        "CountDisplay": {
          "type": "input",
          "top": 300,
          "left": 355,
          "width": 60,
          "height": 20,
          "enterable": false,
          "dataSourceTypeHint": "integer",
          "dataSource": "Form.clickCount",
          "textAlign": "center",
          "fontWeight": "bold"
        },
        "OK": {
          "type": "button",
          "text": ":xliff:CommonOK",
          "top": 300,
          "left": 440,
          "width": 90,
          "height": 30,
          "style": "regular",
          "defaultButton": true,
          "action": "accept",
          "events": ["onClick"]
        }
      }
    },
    {
      "objects": {
        "Instructions": {
          "type": "text",
          "text": "Try: click, double-click, Shift+click, ⌘+click, right-click",
          "top": 40,
          "left": 20,
          "width": 220,
          "height": 40,
          "fontSize": 10,
          "fontStyle": "italic"
        },
        "BtnEvent": {
          "type": "button",
          "text": ":xliff:ButtonClick",
          "top": 90,
          "left": 40,
          "width": 160,
          "height": 50,
          "style": "flat",
          "focusable": true,
          "method": "ObjectMethods/BtnEvent.4dm",
          "events": ["onClick", "onDoubleClick"],
          "tooltip": "Try different click combinations!"
        },
        "BtnClear": {
          "type": "button",
          "text": "Clear Log",
          "top": 160,
          "left": 40,
          "width": 160,
          "height": 30,
          "style": "flat",
          "focusable": false,
          "method": "ObjectMethods/BtnClear.4dm",
          "events": ["onClick"],
          "stroke": "#CC0000"
        },
        "BtnShortcut": {
          "type": "button",
          "text": "⌘K Shortcut",
          "top": 210,
          "left": 40,
          "width": 160,
          "height": 30,
          "style": "flat",
          "method": "ObjectMethods/BtnShortcut.4dm",
          "events": ["onClick"],
          "shortcutAccel": true,
          "shortcutKey": "k",
          "shortcutShift": false,
          "shortcutAlt": false,
          "shortcutControl": false,
          "tooltip": "Or press ⌘K"
        }
      }
    }
  ],
  "geometryStamp": 1,
  "editor": {
    "activeView": "View 1",
    "defaultView": "View 1",
    "views": {
      "View 1": {}
    }
  }
}
