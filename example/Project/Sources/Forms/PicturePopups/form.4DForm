{
    "$4d": {
        "version": "1",
        "kind": "form"
    },
    "windowSizingX": "variable",
    "windowSizingY": "variable",
    "windowMinWidth": 0,
    "windowMinHeight": 0,
    "windowMaxWidth": 32767,
    "windowMaxHeight": 32767,
    "rightMargin": 20,
    "bottomMargin": 20,
    "events": [
        "onLoad",
        "onUnload"
    ],
    "windowTitle": "PicturePopups",
    "destination": "detailScreen",
    "pages": [
        {
            "objects": {}
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Picture pop-up menu, no selection (Form.popupLang = 0)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupLang": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 80,
                    "height": 80,
                    "picture": "/RESOURCES/Images/langSelector.png",
                    "rowCount": 1,
                    "columnCount": 5,
                    "dataSource": "Form.popupLang"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Picture pop-up menu, pre-selected (Form.popupLangSel = 3)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupLangSel": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 80,
                    "height": 80,
                    "picture": "/RESOURCES/Images/langSelector.png",
                    "rowCount": 1,
                    "columnCount": 5,
                    "dataSource": "Form.popupLangSel"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Picture pop-up menu with gotoPage standard action (no dataSource)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupGoto": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 80,
                    "height": 80,
                    "picture": "/RESOURCES/Images/langSelector.png",
                    "rowCount": 1,
                    "columnCount": 5,
                    "action": "gotoPage"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Picture pop-up menu with borderStyle: solid",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupBorder": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 80,
                    "height": 80,
                    "picture": "/RESOURCES/Images/langSelector.png",
                    "rowCount": 1,
                    "columnCount": 5,
                    "dataSource": "Form.popupBorder",
                    "borderStyle": "solid"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Object size (160x160) larger than frame (80x80): scale test",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupBig": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 160,
                    "height": 160,
                    "picture": "/RESOURCES/Images/langSelector.png",
                    "rowCount": 1,
                    "columnCount": 5,
                    "dataSource": "Form.popupBig"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Object size (40x40) smaller than frame (80x80): scale test",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupSmall": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 40,
                    "height": 40,
                    "picture": "/RESOURCES/Images/langSelector.png",
                    "rowCount": 1,
                    "columnCount": 5,
                    "dataSource": "Form.popupSmall"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "2x2 grid (rowCount=2, columnCount=2): frame 0 (position 1) always shown in template",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "popupGrid": {
                    "type": "picturePopup",
                    "top": 30,
                    "left": 10,
                    "width": 160,
                    "height": 160,
                    "picture": "/RESOURCES/Images/grid2x2.png",
                    "rowCount": 2,
                    "columnCount": 2,
                    "dataSource": "Form.popupGrid"
                }
            }
        }
    ]
}