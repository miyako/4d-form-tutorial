{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "windowSizingX": "variable",
  "windowSizingY": "variable",
  "windowMinWidth": 0,
  "windowMinHeight": 0,
  "windowMaxWidth": 32767,
  "windowMaxHeight": 32767,
  "rightMargin": 20,
  "bottomMargin": 20,
  "events": [
    "onLoad",
    "onUnload"
  ],
  "windowTitle": "Popup Menu Demo",
  "destination": "detailScreen",
  "pages": [
    {
      "objects": {}
    },
    {
      "objects": {
        "BtnPopup": {
          "type": "button",
          "text": "Actions",
          "top": 20,
          "left": 20,
          "width": 160,
          "height": 34,
          "style": "bevel",
          "popupPlacement": "separated",
          "events": [
            "onClick",
            "onDoubleClick",
            "onAlternateClick",
            "onLongClick"
          ],
          "method": "ObjectMethods/BtnPopup.4dm"
        },
        "OK": {
          "type": "button",
          "text": "OK",
          "top": 80,
          "left": 20,
          "width": 100,
          "height": 30,
          "style": "regular",
          "defaultButton": true,
          "action": "accept",
          "events": [
            "onClick"
          ]
        }
      }
    }
  ],
  "geometryStamp": 1,
  "editor": {
    "activeView": "View 1",
    "defaultView": "View 1",
    "views": {
      "View 1": {}
    }
  }
}