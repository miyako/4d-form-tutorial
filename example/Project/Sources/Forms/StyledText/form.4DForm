{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": ["onLoad"],
	"method": "method.4dm",
	"destination": "detailScreen",
	"windowTitle": "Styled Text Tests",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
