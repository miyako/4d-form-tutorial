{
  "destination": "detailScreen",
  "windowTitle": "List from Editor (Load list)",
  "windowMinWidth": 400,
  "windowMinHeight": 400,
  "events": ["onLoad", "onUnload"],
  "method": "ObjectMethods/ListFromEditor.4dm",
  "pages": [
    {
      "objects": {}
    },
    {
      "objects": {
        "title": {
          "type": "text",
          "text": "Loaded via Load list (\"FoodTaxonomy\")",
          "left": 20,
          "top": 10,
          "width": 360,
          "height": 24,
          "fontWeight": "bold",
          "fontSize": 14,
          "stroke": "#2C3E50"
        },
        "myList": {
          "type": "list",
          "left": 20,
          "top": 44,
          "width": 360,
          "height": 340,
          "dataSource": "Form.listRef",
          "dataSourceTypeHint": "integer",
          "focusable": true,
          "enterable": false,
          "selectionMode": "single",
          "scrollbarVertical": "automatic",
          "borderStyle": "system",
          "events": ["onClick", "onDoubleClick", "onExpand", "onCollapse", "onSelectionChange"]
        }
      }
    }
  ]
}
