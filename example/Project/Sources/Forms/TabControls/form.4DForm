{
    "$4d": {
        "version": "1",
        "kind": "form"
    },
    "windowSizingX": "variable",
    "windowSizingY": "variable",
    "windowMinWidth": 0,
    "windowMinHeight": 0,
    "windowMaxWidth": 32767,
    "windowMaxHeight": 32767,
    "rightMargin": 20,
    "bottomMargin": 20,
    "events": [
        "onLoad",
        "onUnload"
    ],
    "windowTitle": "TabControls",
    "destination": "detailScreen",
    "pages": [
        {
            "objects": {}
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Object-based tab (Form.tabObj = {values, index, currentValue}) + gotoPage",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabObj": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 24,
                    "dataSource": "Form.tabObj",
                    "dataSourceTypeHint": "object",
                    "action": "gotoPage"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Array-based tab (Text array arrPages, 1-based) + gotoPage",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabArr": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 24,
                    "dataSource": "arrPages",
                    "dataSourceTypeHint": "arrayText",
                    "action": "gotoPage"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Static list tab (labels property, no dataSource) + gotoPage",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabLabels": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 24,
                    "labels": [
                        "Home",
                        "Profile",
                        "Settings"
                    ],
                    "action": "gotoPage"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "labelsPlacement: bottom (macOS only; Windows ignores and stays on top)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabBottom": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 24,
                    "labels": [
                        "Alpha",
                        "Beta",
                        "Gamma"
                    ],
                    "labelsPlacement": "bottom",
                    "action": "gotoPage"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Array-based tab, no standard action -- manual FORM GOTO PAGE(arrManual) in On Clicked",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabManual": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 24,
                    "dataSource": "arrManual",
                    "dataSourceTypeHint": "arrayText",
                    "events": [
                        "onClicked"
                    ]
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "Hierarchical list tab (dataSourceTypeHint: integer) -- list reference built by code, icons via Hierarchical List commands",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabHierarchical": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 24,
                    "dataSource": "Form.tabHierarchical",
                    "dataSourceTypeHint": "integer"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "labelsPlacement: bottom, tall object (150px) to make placement visible",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabBottomTall": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 150,
                    "labels": [
                        "Alpha",
                        "Beta",
                        "Gamma"
                    ],
                    "labelsPlacement": "bottom",
                    "action": "gotoPage"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "labelsPlacement: top (default), tall object (150px) for comparison",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "tabTopTall": {
                    "type": "tab",
                    "top": 30,
                    "left": 10,
                    "width": 300,
                    "height": 150,
                    "labels": [
                        "Alpha",
                        "Beta",
                        "Gamma"
                    ],
                    "action": "gotoPage"
                }
            }
        }
    ]
}