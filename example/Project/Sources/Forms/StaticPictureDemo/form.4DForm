{
	"$4d": { "version": "1", "kind": "form" },
	"windowSizingX": "variable", "windowSizingY": "variable",
	"windowMinWidth": 0, "windowMinHeight": 0, "windowMaxWidth": 32767, "windowMaxHeight": 32767,
	"rightMargin": 20, "bottomMargin": 20,
	"events": ["onLoad"],
	"windowTitle": "Static Picture Demo",
	"destination": "detailScreen",
	"pages": [
		{ "objects": {} },
		{
			"objects": {
				"lblTitle": { "type": "text", "text": "Display (pictureFormat): source is vector.svg, 100x100, stretched into a 180x120 box", "top": 5, "left": 10, "width": 600, "height": 16 },
				"lblScaled": { "type": "text", "text": "scaled", "top": 30, "left": 10, "width": 180, "height": 16 },
				"picScaled": { "type": "picture", "top": 50, "left": 10, "width": 180, "height": 120, "picture": "/RESOURCES/Images/vector.svg", "pictureFormat": "scaled" },
				"lblTiled": { "type": "text", "text": "tiled", "top": 30, "left": 210, "width": 180, "height": 16 },
				"picTiled": { "type": "picture", "top": 50, "left": 210, "width": 180, "height": 120, "picture": "/RESOURCES/Images/vector.svg", "pictureFormat": "tiled" },
				"lblTruncCenter": { "type": "text", "text": "truncatedCenter", "top": 30, "left": 410, "width": 180, "height": 16 },
				"picTruncCenter": { "type": "picture", "top": 50, "left": 410, "width": 180, "height": 120, "picture": "/RESOURCES/Images/vector.svg", "pictureFormat": "truncatedCenter" },
				"lblTruncTopLeft": { "type": "text", "text": "truncatedTopLeft", "top": 30, "left": 610, "width": 180, "height": 16 },
				"picTruncTopLeft": { "type": "picture", "top": 50, "left": 610, "width": 180, "height": 120, "picture": "/RESOURCES/Images/vector.svg", "pictureFormat": "truncatedTopLeft" },
				"lblNote": { "type": "text", "text": "Note: box (180x120) is not proportional to the 100x100 source, so 'scaled' visibly distorts the circle into an ellipse.", "top": 185, "left": 10, "width": 780, "height": 16 }
			}
		},
		{
			"objects": {
				"lblTitle3": { "type": "text", "text": "Scale-factor (@nx) resolution: logical box is 64x64, icon.png has icon@2x.png / icon@3x.png next to it", "top": 5, "left": 10, "width": 780, "height": 16 },
				"lblScale": { "type": "text", "text": "icon.png (64x64 box, picks highest available @nx for the current screen)", "top": 30, "left": 10, "width": 500, "height": 16 },
				"picScale": { "type": "picture", "top": 50, "left": 10, "width": 64, "height": 64, "picture": "/RESOURCES/Images/icon.png", "pictureFormat": "truncatedTopLeft" },
				"lblScaleFit": { "type": "text", "text": "same source, format=scaled, box=160x160 (upscaled well past 1x)", "top": 130, "left": 10, "width": 500, "height": 16 },
				"picScaleFit": { "type": "picture", "top": 150, "left": 10, "width": 160, "height": 160, "picture": "/RESOURCES/Images/icon.png", "pictureFormat": "scaled" }
			}
		},
		{
			"objects": {
				"lblTitle4": { "type": "text", "text": "SVG non-scaling-stroke: 100x100 viewBox blown up into a 320x320 box (format=scaled)", "top": 5, "left": 10, "width": 780, "height": 16 },
				"lblScalingStroke": { "type": "text", "text": "grid_scaling.svg (stroke-width scales up with the box -> thick lines)", "top": 30, "left": 10, "width": 400, "height": 16 },
				"picScalingStroke": { "type": "picture", "top": 50, "left": 10, "width": 320, "height": 320, "picture": "/RESOURCES/Images/grid_scaling.svg", "pictureFormat": "scaled" },
				"lblNonScalingStroke": { "type": "text", "text": "grid_nonscaling.svg (vector-effect=non-scaling-stroke -> lines stay 1px)", "top": 30, "left": 350, "width": 400, "height": 16 },
				"picNonScalingStroke": { "type": "picture", "top": 50, "left": 350, "width": 320, "height": 320, "picture": "/RESOURCES/Images/grid_nonscaling.svg", "pictureFormat": "scaled" }
			}
		},
		{
			"objects": {
				"lblTitle6": { "type": "text", "text": "Other native formats, format=scaled, box=100x100", "top": 5, "left": 10, "width": 780, "height": 16 },
				"lblJpg": { "type": "text", "text": "JPEG", "top": 30, "left": 10, "width": 100, "height": 16 },
				"picJpg": { "type": "picture", "top": 50, "left": 10, "width": 100, "height": 100, "picture": "/RESOURCES/Images/photo.jpg", "pictureFormat": "scaled" },
				"lblBmp": { "type": "text", "text": "BMP", "top": 30, "left": 120, "width": 100, "height": 16 },
				"picBmp": { "type": "picture", "top": 50, "left": 120, "width": 100, "height": 100, "picture": "/RESOURCES/Images/bitmap.bmp", "pictureFormat": "scaled" },
				"lblTiff": { "type": "text", "text": "TIFF", "top": 30, "left": 230, "width": 100, "height": 16 },
				"picTiff": { "type": "picture", "top": 50, "left": 230, "width": 100, "height": 100, "picture": "/RESOURCES/Images/scan.tiff", "pictureFormat": "scaled" },
				"lblGif": { "type": "text", "text": "GIF (static)", "top": 30, "left": 340, "width": 100, "height": 16 },
				"picGif": { "type": "picture", "top": 50, "left": 340, "width": 100, "height": 100, "picture": "/RESOURCES/Images/static.gif", "pictureFormat": "scaled" },
				"lblGifAnim": { "type": "text", "text": "GIF (animated, runtime only)", "top": 30, "left": 450, "width": 130, "height": 16 },
				"picGifAnim": { "type": "picture", "top": 50, "left": 450, "width": 100, "height": 100, "picture": "/RESOURCES/Images/animated.gif", "pictureFormat": "scaled" },
				"lblWebp": { "type": "text", "text": "WEBP (mac only)", "top": 30, "left": 560, "width": 100, "height": 16 },
				"picWebp": { "type": "picture", "top": 50, "left": 560, "width": 100, "height": 100, "picture": "/RESOURCES/Images/photo.webp", "pictureFormat": "scaled" },
				"lblPdf": { "type": "text", "text": "PDF, 1st page (mac only)", "top": 30, "left": 670, "width": 120, "height": 16 },
				"picPdf": { "type": "picture", "top": 50, "left": 670, "width": 100, "height": 100, "picture": "/RESOURCES/Images/document.pdf", "pictureFormat": "scaled" }
			}
		}
	],
	"geometryStamp": 1,
	"editor": { "activeView": "View 1", "defaultView": "View 1", "views": { "View 1": {} } }
}
