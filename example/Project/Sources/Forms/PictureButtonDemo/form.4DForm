{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": ["onLoad"],
	"windowTitle": "Picture Button Demo",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"lblCommand": {
					"type": "text",
					"text": "Command Button (4-state)",
					"top": 110,
					"left": 20,
					"width": 200,
					"height": 20
				},
				"lblSelector": {
					"type": "text",
					"text": "Choice Selector (looping)",
					"top": 110,
					"left": 260,
					"width": 200,
					"height": 20
				}
			}
		},
		{
			"objects": {
				"cmdButton": {
					"type": "pictureButton",
					"top": 20,
					"left": 20,
					"width": 80,
					"height": 80,
					"picture": "/RESOURCES/Images/cmdButton.png",
					"rowCount": 1,
					"columnCount": 4,
					"switchBackWhenReleased": true,
					"switchWhenRollover": true,
					"useLastFrameAsDisabled": true,
					"events": ["onClick"]
				},
				"langSelector": {
					"type": "pictureButton",
					"top": 20,
					"left": 260,
					"width": 80,
					"height": 80,
					"picture": "/RESOURCES/Images/langSelector.png",
					"rowCount": 1,
					"columnCount": 5,
					"loopBackToFirstFrame": true,
					"events": ["onClick"]
				}
			}
		}
	],
	"geometryStamp": 1,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	}
}
