{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": ["onLoad"],
	"windowTitle": "Picture Button Demo",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"picBtnNoImage": {
					"type": "pictureButton",
					"top": 20,
					"left": 20,
					"width": 100,
					"height": 100,
					"rowCount": 1,
					"columnCount": 4,
					"events": ["onClick"]
				},
				"picBtnSwitchBack": {
					"type": "pictureButton",
					"top": 20,
					"left": 140,
					"width": 100,
					"height": 100,
					"rowCount": 1,
					"columnCount": 4,
					"switchBackWhenReleased": true,
					"switchWhenRollover": true,
					"useLastFrameAsDisabled": true,
					"events": ["onClick"]
				},
				"picBtnLoop": {
					"type": "pictureButton",
					"top": 20,
					"left": 260,
					"width": 100,
					"height": 100,
					"rowCount": 1,
					"columnCount": 3,
					"loopBackToFirstFrame": true,
					"events": ["onClick"]
				}
			}
		}
	],
	"geometryStamp": 1,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	}
}
