{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "windowSizingX": "variable",
  "windowSizingY": "variable",
  "windowMinWidth": 0,
  "windowMinHeight": 0,
  "windowMaxWidth": 32767,
  "windowMaxHeight": 32767,
  "rightMargin": 20,
  "bottomMargin": 20,
  "events": ["onLoad", "onClick", "onUnload"],
  "windowTitle": "Form Class Showcase",
  "destination": "detailScreen",
  "formClass": "FormClassShowcaseController",
  "pages": [
    {
      "objects": {}
    },
    {
      "objects": {
        "Title": {
          "type": "text",
          "text": "Form Class Demo",
          "top": 15,
          "left": 20,
          "width": 300,
          "height": 30,
          "fontSize": 18,
          "fontWeight": "bold"
        },
        "BtnIncrement": {
          "type": "button",
          "text": ":xliff:ButtonClick",
          "top": 60,
          "left": 20,
          "width": 160,
          "height": 40,
          "style": "flat",
          "method": "ObjectMethods/BtnIncrement.4dm",
          "events": ["onClick"]
        },
        "MessageDisplay": {
          "type": "input",
          "top": 120,
          "left": 20,
          "width": 250,
          "height": 20,
          "enterable": false,
          "dataSource": "Form:C1466.message",
          "fontSize": 14,
          "textAlign": "center"
        },
        "CountDisplay": {
          "type": "input",
          "top": 150,
          "left": 20,
          "width": 250,
          "height": 30,
          "enterable": false,
          "dataSourceTypeHint": "integer",
          "dataSource": "Form:C1466.clickCount",
          "fontSize": 24,
          "fontWeight": "bold",
          "textAlign": "center"
        },
        "OK": {
          "type": "button",
          "text": ":xliff:CommonOK",
          "top": 200,
          "left": 160,
          "width": 110,
          "height": 34,
          "style": "regular",
          "defaultButton": true,
          "action": "accept",
          "events": ["onClick"]
        }
      }
    }
  ],
  "geometryStamp": 1,
  "editor": {
    "activeView": "View 1",
    "defaultView": "View 1",
    "views": {
      "View 1": {}
    }
  }
}
