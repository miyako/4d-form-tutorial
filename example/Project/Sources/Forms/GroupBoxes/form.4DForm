{
    "$4d": {
        "version": "1",
        "kind": "form"
    },
    "windowSizingX": "variable",
    "windowSizingY": "variable",
    "windowMinWidth": 0,
    "windowMinHeight": 0,
    "windowMaxWidth": 32767,
    "windowMaxHeight": 32767,
    "rightMargin": 20,
    "bottomMargin": 20,
    "events": [
        "onLoad",
        "onUnload"
    ],
    "windowTitle": "GroupBoxes",
    "destination": "detailScreen",
    "pages": [
        {
            "objects": {}
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "groupBox with \"text\" property (per generic Title JSON grammar: text)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "grpText": {
                    "type": "groupBox",
                    "text": "Employee Info",
                    "top": 30,
                    "left": 10,
                    "width": 200,
                    "height": 100
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "groupBox with \"title\" property (per groupBox doc's own JSON example)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "grpTitleProp": {
                    "type": "groupBox",
                    "title": "Employee Info",
                    "top": 30,
                    "left": 10,
                    "width": 200,
                    "height": 100
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "groupBox visually containing other objects (simple z-order overlay, no true containment)",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "grpContainer": {
                    "type": "groupBox",
                    "text": "Contact Details",
                    "top": 30,
                    "left": 10,
                    "width": 250,
                    "height": 120
                },
                "lblName": {
                    "type": "text",
                    "text": "Name:",
                    "top": 55,
                    "left": 25,
                    "width": 60,
                    "height": 16
                },
                "inpName": {
                    "type": "input",
                    "dataSource": "Form.grpName",
                    "top": 55,
                    "left": 90,
                    "width": 150,
                    "height": 20
                },
                "lblEmail": {
                    "type": "text",
                    "text": "Email:",
                    "top": 85,
                    "left": 25,
                    "width": 60,
                    "height": 16
                },
                "inpEmail": {
                    "type": "input",
                    "dataSource": "Form.grpEmail",
                    "top": 85,
                    "left": 90,
                    "width": 150,
                    "height": 20
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "groupBox font/color/alignment: bold, red, right-aligned title",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "grpStyled": {
                    "type": "groupBox",
                    "text": "Styled Group",
                    "top": 30,
                    "left": 10,
                    "width": 220,
                    "height": 100,
                    "bold": true,
                    "stroke": "#FF0000",
                    "textAlign": "right"
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "groupBox with no text/title at all -- bare frame",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "grpBare": {
                    "type": "groupBox",
                    "top": 30,
                    "left": 10,
                    "width": 200,
                    "height": 100
                }
            }
        },
        {
            "objects": {
                "lblTitle": {
                    "type": "text",
                    "text": "groupBox with an XLIFF-referenced title (\":xliff:ButtonClick\" -> \"Click\")",
                    "top": 5,
                    "left": 10,
                    "width": 500,
                    "height": 16
                },
                "grpXliff": {
                    "type": "groupBox",
                    "text": ":xliff:ButtonClick",
                    "top": 30,
                    "left": 10,
                    "width": 200,
                    "height": 100
                }
            }
        }
    ]
}