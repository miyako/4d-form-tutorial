{
	"$4d": { "version": "1", "kind": "form" },
	"windowSizingX": "variable", "windowSizingY": "variable",
	"windowMinWidth": 0, "windowMinHeight": 0, "windowMaxWidth": 32767, "windowMaxHeight": 32767,
	"rightMargin": 20, "bottomMargin": 20,
	"events": ["onLoad"],
	"windowTitle": "Static Picture Dark Mode - Dark",
	"destination": "detailScreen",
	"colorScheme": "dark",
	"pages": [
		{ "objects": {} },
		{
			"objects": {
				"lbl": { "type": "text", "text": "colorScheme=dark; picture=theme.png (theme_dark.png present next to it -> should auto-swap)", "top": 5, "left": 10, "width": 600, "height": 16 },
				"pic": { "type": "picture", "top": 30, "left": 10, "width": 100, "height": 100, "picture": "/RESOURCES/Images/theme.png", "pictureFormat": "scaled" }
			}
		}
	],
	"geometryStamp": 1,
	"editor": { "activeView": "View 1", "defaultView": "View 1", "views": { "View 1": {} } }
}
