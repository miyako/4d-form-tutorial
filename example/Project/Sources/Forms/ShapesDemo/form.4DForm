{
	"$4d": { "version": "1", "kind": "form" },
	"windowSizingX": "variable", "windowSizingY": "variable",
	"windowMinWidth": 0, "windowMinHeight": 0, "windowMaxWidth": 32767, "windowMaxHeight": 32767,
	"rightMargin": 20, "bottomMargin": 20,
	"events": ["onLoad"],
	"windowTitle": "Shapes Demo",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"lblRect": { "type": "text", "text": "Rectangles", "top": 5, "left": 10, "width": 200, "height": 16 },
				"lblLine": { "type": "text", "text": "Lines", "top": 5, "left": 280, "width": 200, "height": 16 },
				"lblOval": { "type": "text", "text": "Ovals", "top": 160, "left": 10, "width": 200, "height": 16 }
			}
		},
		{
			"objects": {
				"rectSolid": { "type": "rectangle", "left": 10, "top": 25, "width": 80, "height": 50, "stroke": "#000000", "fill": "transparent", "borderRadius": 0 },
				"rectRounded": { "type": "rectangle", "left": 100, "top": 25, "width": 80, "height": 50, "stroke": "#3B82F6", "fill": "#DBEAFE", "borderRadius": 12 },
				"rectFilled": { "type": "rectangle", "left": 190, "top": 25, "width": 60, "height": 50, "stroke": "#DC2626", "fill": "#FEE2E2", "borderRadius": 0, "strokeWidth": 3 },
				"rectDashed": { "type": "rectangle", "left": 10, "top": 90, "width": 120, "height": 40, "stroke": "#6B7280", "fill": "transparent", "strokeDashArray": "6 2" },
				"rectThick": { "type": "rectangle", "left": 140, "top": 90, "width": 110, "height": 40, "stroke": "#059669", "fill": "#D1FAE5", "strokeWidth": 4, "borderRadius": 20 },

				"lineTL": { "type": "line", "left": 280, "top": 25, "width": 100, "height": 60, "startPoint": "topLeft", "stroke": "#000000" },
				"lineBL": { "type": "line", "left": 400, "top": 25, "width": 100, "height": 60, "startPoint": "bottomLeft", "stroke": "#3B82F6" },
				"lineHoriz": { "type": "line", "left": 280, "top": 110, "width": 220, "height": 0, "startPoint": "topLeft", "stroke": "#DC2626", "strokeWidth": 2 },
				"lineVert": { "type": "line", "left": 520, "top": 25, "width": 0, "height": 100, "startPoint": "topLeft", "stroke": "#059669", "strokeWidth": 2 },
				"lineDashed": { "type": "line", "left": 280, "top": 130, "width": 220, "height": 0, "startPoint": "topLeft", "stroke": "#6B7280", "strokeDashArray": "8 4" },

				"ovalCircle": { "type": "oval", "left": 10, "top": 180, "width": 60, "height": 60, "stroke": "#000000", "fill": "transparent" },
				"ovalEllipse": { "type": "oval", "left": 80, "top": 180, "width": 100, "height": 60, "stroke": "#3B82F6", "fill": "#DBEAFE" },
				"ovalFilled": { "type": "oval", "left": 190, "top": 180, "width": 60, "height": 60, "stroke": "#DC2626", "fill": "#FEE2E2", "strokeWidth": 3 },
				"ovalDashed": { "type": "oval", "left": 260, "top": 180, "width": 80, "height": 60, "stroke": "#6B7280", "fill": "transparent", "strokeDashArray": "6 2" }
			}
		}
	],
	"geometryStamp": 1,
	"editor": { "activeView": "View 1", "defaultView": "View 1", "views": { "View 1": {} } }
}
