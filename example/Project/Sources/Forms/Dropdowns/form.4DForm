{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onUnload"
	],
	"windowTitle": "Dropdowns",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"lblTitle": {
					"type": "text",
					"text": "Object-based drop-down list (dataSourceTypeHint: object)",
					"top": 5,
					"left": 10,
					"width": 600,
					"height": 16
				},
				"lblIndexed": {
					"type": "text",
					"text": "index: 1 (Banana selected)",
					"top": 30,
					"left": 10,
					"width": 200,
					"height": 16
				},
				"dropFruit": {
					"type": "dropdown",
					"top": 50,
					"left": 10,
					"width": 180,
					"height": 20,
					"dataSource": "Form.dropFruit",
					"dataSourceTypeHint": "object",
					"textFormat": "@"
				},
				"lblPlaceholder": {
					"type": "text",
					"text": "index: -1 (currentValue used as placeholder)",
					"top": 30,
					"left": 210,
					"width": 260,
					"height": 16
				},
				"dropFruitPlaceholder": {
					"type": "dropdown",
					"top": 50,
					"left": 210,
					"width": 180,
					"height": 20,
					"dataSource": "Form.dropFruitPlaceholder",
					"dataSourceTypeHint": "object",
					"textFormat": "@"
				}
			}
		},
		{
			"objects": {
				"lblTitle": {
					"type": "text",
					"text": "Array-based drop-down list (dataSourceTypeHint: arrayText), backed by a 4D array variable",
					"top": 5,
					"left": 10,
					"width": 600,
					"height": 16
				},
				"lblArr": {
					"type": "text",
					"text": "asColor (array populated On Load)",
					"top": 30,
					"left": 10,
					"width": 250,
					"height": 16
				},
				"dropColor": {
					"type": "dropdown",
					"top": 50,
					"left": 10,
					"width": 180,
					"height": 20,
					"dataSource": "asColor",
					"dataSourceTypeHint": "arrayText",
					"events": [
						"onClicked"
					]
				}
			}
		},
		{
			"objects": {
				"lblTitle": {
					"type": "text",
					"text": "Choice list drop-down list: saveAs value vs saveAs reference",
					"top": 5,
					"left": 10,
					"width": 600,
					"height": 16
				},
				"lblValue": {
					"type": "text",
					"text": "saveAs: value (Form.dropSaveValue holds the text \"Blue\")",
					"top": 30,
					"left": 10,
					"width": 320,
					"height": 16
				},
				"dropSaveValue": {
					"type": "dropdown",
					"top": 50,
					"left": 10,
					"width": 180,
					"height": 20,
					"dataSource": "Form.dropSaveValue",
					"choiceList": [
						"Red",
						"Green",
						"Blue"
					],
					"saveAs": "value"
				},
				"lblReference": {
					"type": "text",
					"text": "saveAs: reference (Form.dropSaveReference holds the number 3)",
					"top": 30,
					"left": 210,
					"width": 340,
					"height": 16
				},
				"dropSaveReference": {
					"type": "dropdown",
					"top": 50,
					"left": 210,
					"width": 180,
					"height": 20,
					"dataSource": "Form.dropSaveReference",
					"choiceList": [
						"Red",
						"Green",
						"Blue"
					],
					"saveAs": "reference"
				}
			}
		},
		{
			"objects": {
				"lblTitle": {
					"type": "text",
					"text": "Standard action drop-down list (action: gotoPage), auto-populated with form page numbers",
					"top": 5,
					"left": 10,
					"width": 600,
					"height": 16
				},
				"dropGotoPage": {
					"type": "dropdown",
					"top": 50,
					"left": 10,
					"width": 180,
					"height": 20,
					"action": "gotoPage"
				}
			}
		},
		{
			"objects": {
				"lblTitle": {
					"type": "text",
					"text": "Hierarchical drop-down list (dataSourceTypeHint: integer alone, no object/array/choiceList)",
					"top": 5,
					"left": 10,
					"width": 600,
					"height": 16
				},
				"dropHierarchical": {
					"type": "dropdown",
					"top": 50,
					"left": 10,
					"width": 180,
					"height": 20,
					"dataSource": "Form.dropHierarchical",
					"dataSourceTypeHint": "integer"
				}
			}
		}
	],
	"geometryStamp": 1,
	"formClass": "Dropdowns",
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	}
}
